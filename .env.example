# demo | paper | live
POLYFI_MODE=demo

# Market window: 300 = 5-minute BTC Up/Down (shortest Polymarket offers), 900 = 15-minute
POLYFI_WINDOW_SECONDS=300
POLYFI_ASSET=btc

# Free only = maker (post-only) orders: $0 trading fees + maker rebates
POLYFI_FREE_ONLY=true
POLYFI_STAKE_USD=5
POLYFI_MIN_EDGE=0.04
POLYFI_ENTRY_AFTER_S=20
POLYFI_STOP_BEFORE_END_S=60
POLYFI_MAX_DAILY_LOSS_USD=25

# Live only — polymarket.com → Settings → API Keys → Relayer API Keys (gasless)
SIGNER_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Dashboard
POLYFI_HOST=127.0.0.1
POLYFI_PORT=8787
POLYFI_DASHBOARD_TOKEN=
