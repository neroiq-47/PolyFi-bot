{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polyfi-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "BotContainer",
      "image": "./Dockerfile",
      // 1/4 vCPU, 1 GiB. "lite" (256 MiB) is cheaper but tight for Python + the SDK.
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "POLYFI", "class_name": "BotContainer" }]
  },
  "exports": {
    "BotContainer": { "type": "durable-object", "storage": "sqlite" },
    // Legacy empty class, kept until no deployed version binds it; then switch to
    // { "type": "durable-object", "state": "deleted" } and drop it from worker/index.ts.
    "PolyFi": { "type": "durable-object", "storage": "sqlite" }
  },

  // Keep-alive ping every minute so the bot runs 24/7.
  "triggers": { "crons": ["* * * * *"] },

  // Non-secret settings. Keys go in secrets: `npx wrangler secret put POLYFI_DASHBOARD_TOKEN` etc.
  "vars": {
    "POLYFI_MODE": "paper",
    "POLYFI_WINDOW_SECONDS": "300",
    "POLYFI_FREE_ONLY": "true",
    "POLYFI_STAKE_USD": "5",
    "POLYFI_MAX_DAILY_LOSS_USD": "25",
    // Public identifiers (safe to commit). Keys/secrets go in Settings → Variables and Secrets.
    "POLYMARKET_RELAYER_API_KEY_ADDRESS": "0x554bb7c00683f8628dd8b268821009eac218f216",
    "POLYMARKET_WALLET_ADDRESS": "0x58f50BC95659Dad165D17e5F1e8DBcc5eb9F373C",
    // The ONLY address dashboard withdrawals may go to (USDC on Polygon).
    "POLYFI_WITHDRAW_ADDRESS": "0xE74E2634eF2cBd363F938F060A689e6783d84a21",
    "POLYMARKET_BUILDER_CODE": "0x29e86cba8157e0d4ac968bac6a8a0d0baae3230da8191e753dde2fe2d69a22a4"
  }
}
